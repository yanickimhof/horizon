# Copie ce fichier en .env pour changer le comportement. Le fichier .env n'est jamais versionné.
# Coach sur un modèle local (ollama), rien ne sort de l'ordinateur:
# HORIZON_LLM=ollama
# HORIZON_OLLAMA_MODEL=qwen3:8b
# Mode local imposé, l'interface ne peut pas le changer:
# HORIZON_PRIVACY=local
# Port de l'application:
# HORIZON_PORT=5173
